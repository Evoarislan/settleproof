# Copy to .env and fill in. Never commit .env.
META_API_KEY=
META_API_MODE=standard
PORT=3004

# Payment rail (optional; mock is the default and the public demo stays mock)
# SETTLEPROOF_RAIL=live
# TREASURY_KEY_PATH=/path/outside/the/repo/treasury.key
# SELLER_ADDRESS=0x0000000000000000000000000000000000000000
# DEMO_USDC_RATE=0.01
# BASE_RPC_URL=https://mainnet.base.org

# Demo protection (audit F2/F3). Set DEMO_TOKEN on the public deployment and
# open the demo with ?token=<value> in the presenter link; approve, reject,
# and /demo/* then require the x-demo-token header. Leave unset for local use.
# DEMO_TOKEN=change-me
# MAX_BODY_BYTES=12582912
# MAX_ORDERS=200
# RATE_LIMIT_ORDERS_PER_MIN=30
# RATE_LIMIT_EVIDENCE_PER_MIN=10
